{
  "name": "crash-me-claude",
  "version": "1.0.0",
  "description": "Collects Claude Code and IDE-extension crash and error reports on your computer, redacted, ready to save or send.",
  "type": "module",
  "bin": {
    "crash-me-claude": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "crash",
    "report",
    "bug",
    "diagnostics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buggypather/crash-me-claude"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
